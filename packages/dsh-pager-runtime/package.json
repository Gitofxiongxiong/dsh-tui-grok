{
  "name": "@dsh-pager-grok/runtime",
  "version": "0.1.0",
  "description": "DeepSeek Harness profile bundle for the dsh-pager native TUI",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gitofxiongxiong/dsh-tui-grok.git",
    "directory": "packages/dsh-pager-runtime"
  },
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/assemble-runtime.mjs",
    "prepack": "node ../../scripts/copy-package-licenses.mjs .",
    "test": "vitest run tests"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "exports": {
    "./server": {
      "types": "./lib/server-entry.d.ts",
      "default": "./lib/server-entry.js"
    },
    "./recovery": {
      "types": "./lib/recovery-entry.d.ts",
      "default": "./lib/recovery-entry.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "NOTICE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.8",
    "@deepseek-ai/dsh-brand": "0.1.0-rc.8",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "0.1.0-rc.8",
    "@deepseek-ai/dsh-file-reference": "0.1.0-rc.8",
    "@deepseek-ai/dsh-file-reference-local": "0.1.0-rc.8",
    "@deepseek-ai/dsh-host-apiproxy": "0.1.0-rc.8",
    "@deepseek-ai/dsh-host-directory-picker-browse": "0.1.0-rc.8",
    "@deepseek-ai/dsh-invariants": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-projection-cache": "0.1.0-rc.8",
    "@deepseek-ai/dsh-storage": "0.1.0-rc.8",
    "@deepseek-ai/dsh-storage-domain": "0.1.0-rc.8",
    "@deepseek-ai/dsh-storage-json": "0.1.0-rc.8",
    "@deepseek-ai/dsh-workspace": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": "3.18.1"
  }
}
